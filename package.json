{
  "name": "web-logger",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=@cp949/web-logger --filter=@cp949/web-logger-react && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "size": "pnpm --filter @cp949/web-logger run size && pnpm --filter @cp949/web-logger-react run size",
    "size:core": "pnpm --filter @cp949/web-logger run size",
    "size:react": "pnpm --filter @cp949/web-logger-react run size",
    "size:why": "size-limit --why",
    "size:ci": "size-limit --json",
    "demo": "pnpm ts-node packages/web-logger/scripts/demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@size-limit/file": "^13.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^13.0.3",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.2.1",
      "rollup": "^4.59.0",
      "esbuild": "0.28.2",
      "picomatch@>=4 <4.0.4": "4.0.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
