{
  "name": "web-logger",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=@cp949/web-logger --filter=@cp949/web-logger-react && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "node --test tests/scripts/*.test.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "size": "pnpm --filter @cp949/web-logger run size && pnpm --filter @cp949/web-logger-react run size",
    "size:core": "pnpm --filter @cp949/web-logger run size",
    "size:react": "pnpm --filter @cp949/web-logger-react run size",
    "size:why": "size-limit --why",
    "size:ci": "size-limit --json",
    "demo": "pnpm ts-node packages/web-logger/scripts/demo.ts",
    "verify:ci": "pnpm audit && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm size:ci",
    "verify:release": "node ./scripts/verify-release.mjs",
    "publish:npm": "pnpm verify:release && node ./scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@size-limit/file": "^14.3.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "rollup-plugin-visualizer": "^7.1.3",
    "size-limit": "^14.3.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.8",
      "rollup": "^4.59.0",
      "esbuild": "0.28.2",
      "source-map-js": ">=1.2.2",
      "picomatch@>=4 <4.0.4": "4.0.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
